---
import { getImage } from 'astro:assets';
import { SITE } from '~/data/site';
import { photo } from '~/lib/photos';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
}
const { title, description, image = SITE.defaultImage, imageAlt, type = 'website', published, updated, noindex, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', SITE.url).href;
const og = await getImage({ src: photo(image), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const ogUrl = new URL(og.src, SITE.url).href;
const fullTitle = title.includes(SITE.name) || title.length + SITE.name.length + 3 > 62 ? title : `${title} | ${SITE.name}`;

const graph = [
  {
    '@type': 'WebSite',
    '@id': `${SITE.url}/#website`,
    url: SITE.url,
    name: SITE.name,
    description: SITE.description,
    inLanguage: 'nl-NL',
    publisher: { '@id': `${SITE.url}/#mart` },
  },
  {
    '@type': 'Person',
    '@id': `${SITE.url}/#mart`,
    name: SITE.author.name,
    url: SITE.author.url,
    description: SITE.author.description,
    image: new URL('/icon-512.png', SITE.url).href,
  },
  ...schema,
];
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
<meta name="author" content={SITE.author.name} />

<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{published && <meta property="article:published_time" content={published.toISOString()} />}
{updated && <meta property="article:modified_time" content={updated.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

<script type="application/ld+json" set:html={ld} />
