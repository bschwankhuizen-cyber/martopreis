---
/** Privacyvriendelijke kaart: OpenStreetMap-embed (laadt lazy) + link naar Google Maps */
interface Props { lat: number; lng: number; titel: string; zoom?: number; googleMaps?: string }
const { lat, lng, titel, zoom = 13, googleMaps } = Astro.props;
const d = 0.6 / Math.pow(2, zoom - 10);
const bbox = [lng - d * 1.6, lat - d, lng + d * 1.6, lat + d].map((n) => n.toFixed(5)).join(',');
const osm = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat},${lng}`;
const gm = googleMaps ?? `https://www.google.com/maps/search/?api=1&query=${lat},${lng}`;
---

<figure class="kaart wide">
  <iframe src={osm} title={`Kaart: ${titel}`} loading="lazy" referrerpolicy="no-referrer"></iframe>
  <figcaption>
    <span>📍 {titel}</span>
    <a href={gm} target="_blank" rel="noopener">Open in Google Maps →</a>
  </figcaption>
</figure>

<style>
  .kaart { margin: 2em auto; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--line); background: var(--card); }
  iframe { width: 100%; height: 380px; border: 0; display: block; }
  figcaption { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 12px 16px; font-size: 0.93rem; }
</style>
