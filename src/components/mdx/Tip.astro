---
interface Props { titel?: string; soort?: 'tip' | 'info' | 'let-op' }
const { titel, soort = 'tip' } = Astro.props;
const icon = { tip: '💡', info: 'ℹ️', 'let-op': '⚠️' }[soort];
const label = titel ?? { tip: 'Tip van Mart', info: 'Goed om te weten', 'let-op': 'Let op' }[soort];
---

<aside class:list={['tip', `tip--${soort}`]}>
  <p class="tip__t"><span aria-hidden="true">{icon}</span> {label}</p>
  <div class="tip__b"><slot /></div>
</aside>

<style>
  .tip { margin: 2em auto; padding: 18px 22px; border-radius: var(--radius); background: var(--sun-2); border-left: 5px solid var(--sun); }
  .tip--info { background: var(--teal-2); border-color: var(--teal); }
  .tip--let-op { background: #fbe6dc; border-color: var(--terra); }
  .tip__t { font: 700 0.95rem/1.3 var(--sans); margin: 0 0 6px; }
  .tip__b :global(p:last-child) { margin-bottom: 0; }
  .tip__b :global(ul) { margin-bottom: 0; }
</style>
