---
interface Props { items: { name: string; href: string }[]; current: string }
const { items, current } = Astro.props;
---

<nav class="bc" aria-label="Kruimelpad">
  <ol>
    {items.map((c) => <li><a href={c.href}>{c.name}</a></li>)}
    <li aria-current="page">{current}</li>
  </ol>
</nav>

<style>
  .bc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 0; font-size: 0.85rem; }
  .bc li { color: inherit; opacity: 0.9; }
  .bc li + li::before { content: '/'; margin: 0 8px; opacity: 0.6; }
  .bc a { color: inherit; text-decoration: none; }
  .bc a:hover { text-decoration: underline; color: inherit; }
</style>
